+/// TRACE (bench instrumentation, not upstream): enabled by env LEIDEN_TRACE.
+pub(crate) fn trace_on() -> bool {
+    static T: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *T.get_or_init(|| std::env::var_os("LEIDEN_TRACE").is_some())
+}
+
+/// TRACE: hash of the graph's structure and exact weight bits.
+fn trace_graph_hash(d: &GraphData) -> u64 {
+    use std::hash::{Hash, Hasher};
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    d.out_offsets.hash(&mut h);
+    d.out_targets.hash(&mut h);
+    for w in &d.out_weights { w.to_bits().hash(&mut h); }
+    for w in &d.node_weight { w.to_bits().hash(&mut h); }
+    h.finish()
+}
+
+/// TRACE: number of communities of `p` whose induced subgraph in `d` is disconnected.
+fn trace_disconnected(d: &GraphData, p: &Partition) -> usize {
+    let n = d.node_count();
+    let mut seen = vec![false; n];
+    let mut parts = vec![0usize; p.num_communities()];
+    for s in 0..n {
+        if seen[s] { continue; }
+        parts[p.community_of(s)] += 1;
+        seen[s] = true;
+        let mut stack = vec![s];
+        while let Some(u) = stack.pop() {
+            for &v in d.neighbor_slices(u).0 {
+                if !seen[v] && p.community_of(v) == p.community_of(u) {
+                    seen[v] = true;
+                    stack.push(v);
+                }
+            }
+        }
+    }
+    parts.iter().filter(|&&c| c > 1).count()
+}
